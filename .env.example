# Copy to .env (it is gitignored) and change every value. Used by docker compose, the hub, the mocks, tests and chaos.
# Database password: docker compose creates the database with it; the hub connects with it.
HUB_DB_PASSWORD=change-me-db-password
HUB_DATABASE_URL=postgresql://hub:change-me-db-password@127.0.0.1:5434/hub

# Comma separated. First entry is the current secret, the rest are still accepted (rotation window).
# The hub refuses to start without it.
HUB_WEBHOOK_SECRETS=change-me-current,change-me-previous
# Admin endpoints (/deliveries, /metrics) are disabled while this is empty.
HUB_ADMIN_KEY=change-me-admin

# Destinations (defaults point at the local mocks on port 9000).
HUB_WAREHOUSE__CLIENT_ID=hub-warehouse
HUB_WAREHOUSE__CLIENT_SECRET=dev-warehouse-secret
HUB_HELPDESK__API_KEY=dev-helpdesk-key
HUB_ACCOUNTING__CLIENT_ID=hub-accounting
HUB_ACCOUNTING__CLIENT_SECRET=dev-accounting-secret

# Mock providers (python -m mocks reads this file)
MOCK_ADMIN_KEY=change-me-admin
MOCK_WEBHOOK_SECRET=change-me-current
